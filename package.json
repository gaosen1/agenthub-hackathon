{
  "name": "agenthub",
  "private": true,
  "version": "0.1.0",
  "description": "AgentHub — 本地 Coding Agent Session 的云端接力平台（Team 055 / QwenBots）",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "dev:hub": "pnpm --filter @agenthub/hub-server dev",
    "dev:web": "pnpm --filter @agenthub/hub-web dev",
    "test": "pnpm -r --filter './packages/*' test"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.10.0"
  }
}
