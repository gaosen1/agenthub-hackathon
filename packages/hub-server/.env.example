# AgentHub hub-server 本地开发环境变量（复制为 .env 后填入真实值）
# 密钥不进仓库；此文件仅模板，提交安全。

# ── 必填 ──
HUB_SECRET_KEY=your-secret-key-here
HUB_DB_PATH=./data/hub.sqlite

# ── 阿里云 OSS（spec §3.9）──
OSS_BUCKET=your-agenthub-bucket
OSS_REGION=oss-cn-hangzhou
OSS_AK=your-access-key-id
OSS_SK=your-access-key-secret

# ── K8s 编排（不设则降级为纯控制面，spec §5）──
SANDBOX_NAMESPACE=agenthub
SANDBOX_IMAGE=<YOUR_ACR_REGISTRY>/agenthub-demo/sandbox:dev
SANDBOX_PULL_SECRET=acr-pull

# ── task 完成后 Pod 留驻分钟数（spec §4.1：task 已完成的会话可长驻继续对话）──
# 0=完成即打包（任务接力模式）；>0=留驻供 Web/钉钉继续聊
TASK_LINGER_MINUTES=30

# ── 可选 ──
# HUB_PORT=4180
# HUB_HOST=127.0.0.1
# HUB_WEB_URL=http://localhost:4180
# SANDBOX_IDLE_TTL_MINUTES=120
# WORKER_INTERVAL_MS=5000
